# Names and non-secret examples only. Shared secret values belong in Doppler.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required for deployed environments; inject a generated value from Doppler.
# DJANGO_SECRET_KEY=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-approved-host
# Enable only behind a trusted provider proxy that strips/sets this header.
DJANGO_TRUST_PROXY=false
# Set to the deployed commit for health/readiness verification.
APP_RELEASE=local

# Optional server-side Gemini help. No values are loaded from this file automatically.
# Inject the key through the backend environment/Doppler. Never put it in browser code.
GEMINI_ENABLED=false
# GEMINI_API_KEY=
# Set current generateContent-compatible models after checking provider availability.
GEMINI_TEXT_MODEL=
GEMINI_TTS_MODEL=
GEMINI_AUDIO_MODEL=
GEMINI_TIMEOUT_SECONDS=20
GEMINI_RATE_LIMIT=12
GEMINI_CACHE_TTL_SECONDS=3600
# Production: install requirements-assistance.txt and inject a shared Redis URL.
# GEMINI_CACHE_URL=rediss://...
# Voice uploads stay off until actual provider data-use configuration is verified.
GEMINI_VOICE_INPUT_ENABLED=false
GEMINI_VOICE_INPUT_APPROVED=false
