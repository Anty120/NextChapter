# Names and non-secret examples only. Shared secret values belong in Doppler.
APP_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required for deployed environments; inject a generated value from Doppler.
# DJANGO_SECRET_KEY=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-approved-host
# Enable only behind a trusted provider proxy that strips/sets this header.
DJANGO_TRUST_PROXY=false
# Set to the deployed commit for health/readiness verification.
APP_RELEASE=local
